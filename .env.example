# Copy this file to .env and fill in your values:
#   cp .env.example .env && chmod 600 .env
# Never commit .env (it is in .gitignore).

# --- Rocket.Chat -----------------------------------------------------------
# Your company's Rocket.Chat address (the one you open in the browser).
ROCKETCHAT_URL=https://chat.example.com
# From My Account > Personal Access Tokens (shown once when you create a token).
ROCKETCHAT_USER_ID=<your-user-id>
ROCKETCHAT_TOKEN=<your-personal-access-token>

# --- Telegram --------------------------------------------------------------
# From @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=<your-bot-token>
# Your numeric Telegram user id. Get it with: uv run telerocket whoami
TELEGRAM_OWNER_ID=<your-telegram-user-id>

# --- Behaviour (optional) --------------------------------------------------
# dm_mentions = direct messages + messages that mention you (default)
# all         = every message in every room you are in
FORWARD_SCOPE=dm_mentions
# Comma separated room names that are never forwarded, e.g. general,random
IGNORE_ROOMS=
# Where the local id database is kept.
DATA_DIR=data
LOG_LEVEL=INFO
